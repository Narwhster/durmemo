{
  "name": "opencode-durmemo",
  "version": "0.1.0",
  "description": "Durable Memory for OpenCode",
  "homepage": "https://github.com/narwhster/durmemo#readme",
  "bugs": {
    "url": "https://github.com/narwhster/durmemo/issues"
  },
  "license": "MIT",
  "author": "Narwhster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narwhster/durmemo.git"
  },
  "files": [
    "dist",
    "src/tui.ts",
    "src/tui",
    "src/names.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./rpc": "./dist/rpc.mjs",
    "./package.json": "./package.json",
    "./tui": "./src/tui.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/rpc.ts",
    "dev": "vp pack src/index.ts src/rpc.ts --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-18743",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@opencode/plugin": "0.0.0-beta-19425",
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "solid-js": "^1.9.15",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  }
}
